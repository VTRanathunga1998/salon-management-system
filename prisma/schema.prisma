generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum UserRole {
  OWNER
  MANAGER
  RECEPTIONIST
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT // being built, not yet finalized/printed
  ISSUED // finalized, awaiting payment
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model User {
  id       String   @id @default(cuid())
  username String   @unique
  password String
  role     UserRole @default(OWNER)

  createdInvoices Invoice[] @relation("InvoiceCreatedBy")
  sessions        Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String  @unique
  email   String?
  address String?

  invoices Invoice[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Employee {
  id    String  @id @default(cuid())
  name  String
  phone String?
  email String?
  address String?

  // Soft delete: never hard-delete an employee referenced by invoices.
  isActive Boolean @default(true)

  invoiceItems InvoiceItem[]
  appointmentServices AppointmentService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  duration    Int // Minutes
  price       Decimal @db.Decimal(10, 2)

  // Soft delete: never hard-delete a service referenced by invoices.
  isActive Boolean @default(true)

  invoiceItems InvoiceItem[]
  appointmentServices AppointmentService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Appointment {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  date      DateTime // day only, time zeroed — makes date-range filtering simple
  startTime DateTime // full timestamp (date + start time combined)
  endTime   DateTime // full timestamp (date + end time combined)

  status AppointmentStatus @default(PENDING)

  notes String?

  cancelledAt  DateTime?
  cancelReason String?

  services AppointmentService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([date])
  @@index([status])
}

model AppointmentService {
  id String @id @default(cuid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // Optional: staff may not be assigned at booking time, only once confirmed.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  serviceNameSnapshot String

  @@index([appointmentId])
  @@index([serviceId])
  @@index([employeeId])
}

// Atomic counter used to generate gap-free, race-condition-free invoice numbers.
// One row per numbering series (e.g. per year: "INV-2026").
model InvoiceCounter {
  id           String @id @default(cuid())
  seriesKey    String @unique // e.g. "2026"
  lastNumber   Int    @default(0)
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique // e.g. "INV-2026-000123"

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById String?
  createdBy   User?   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  status InvoiceStatus @default(DRAFT)

  subtotal Decimal @db.Decimal(10, 2) // sum of item subtotals, pre-discount/tax

  discountType  DiscountType @default(FIXED)
  discountValue Decimal      @default(0) @db.Decimal(10, 2) // amount or percentage depending on discountType
  discountTotal Decimal      @default(0) @db.Decimal(10, 2) // resolved discount amount, always stored in currency units

  taxRate   Decimal @default(0) @db.Decimal(5, 2) // e.g. 8.00 = 8%
  taxTotal  Decimal @default(0) @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2) // subtotal - discountTotal + taxTotal

  notes String?

  cancelledAt  DateTime?
  cancelReason String?

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Snapshot the service name/price at time of sale so historical invoices
  // stay accurate even if the Service record is later edited or deactivated.
  serviceNameSnapshot String

  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2) // snapshot of Service.price at sale time
  subtotal  Decimal @db.Decimal(10, 2) // quantity * unitPrice

  @@index([invoiceId])
  @@index([employeeId])
}

model Payment {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal       @db.Decimal(10, 2)
  method PaymentMethod
  status PaymentStatus @default(COMPLETED)

  // For card/bank payments - useful for reconciliation and preventing duplicates
  reference String?

  paidAt DateTime @default(now())

  @@index([invoiceId])
}

